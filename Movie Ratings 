        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "df = pd.read_csv(\"movie_ratings.csv\")\n",
        "print(df.head())\n",
        "print(df.info())\n",
        "print(df.describe())\n",
        "print(df.is)null().sum()\n",
        "df = df.dropna()\n",
        "print(df.head())\n",
        "\n",
        "mean_rating = np.mean(df[\"Rating\"])\n",
        "print(\"Mean:\", mean_rating)\n",
        "\n",
        "median_rating = np.median(df[\"Rating\"])\n",
        "print(\"Median:\", median_rating)\n",
        "\n",
        "std_rating = np.std(df[\"Rating\"])\n",
        "print(\"Standard Deviation:\", std_rating)\n",
        "\n",
        "print(\"Average Budget:\", np.mean(df['Budget_USD']))\n",
        "print(\"Average Revenue:\", np.mean(df[\"Revenue_USD\"]))\n",
        "\n",
        "genre_rating = df.groupby(\"Genre\")[\"Rating\"].mean()\n",
        "print(genre_rating)\n",
        "\n",
        "director_rating = df.groupby(\"Director\")[\"Rating\"].mean()\n",
        "print(director_rating)\n",
        "\n",
        "year_rating = df.groupby(\"Year\")[\"Rating\"].mean()\n",
        "print(year_rating)\n",
        "\n",
        "\n",
        "genre_rating.plot(kind='bar')\n",
        "plt.title(\"Average Rating by genre\")\n",
        "plt.xlabel(\"Genre\")\n",
        "plt.ylabel(\"Rating\")\n",
        "plt.show()\n",
        "\n",
        "director_rating.plot(kind='bar')\n",
        "plt.title(\"Average Rating by director\")\n",
        "plt.xlabel(\"Director\")\n",
        "plt.ylabel(\"Rating\")\n",
        "plt.show()\n",
        "\n",
        "year_rating.plot(kind='line', marker='o')\n",
        "plt.title(\"Average Rating over Years\")\n",
        "plt.xlabel(\"Year\")\n",
        "plt.ylabel(\"Rating\")\n",
        "plt.show()\n",
        "\n",
        "plt.scatter(df['Budget_USD'], df['Rating'])\n",
        "plt.title(\"Budget vs Rating\")\n",
        "plt.xlabel(\"Budget\")\n",
        "plt.ylabel(\"Rating\")\n",
        "plt.show()\n",
        "\n",
        "plt.scatter(df['Revenue_USD'], df['Rating'])\n",
        "plt.title(\"Revenue vs Rating\")\n",
        "plt.xlabel(\"Revenue\")\n",
        "plt.ylabel(\"Rating\")\n",
        "plt.show()\n",
        "\n",
        "top_movies = df.sort_values(\"Rating\", ascending=False).head()\n",
        "plt.barh(top_movies[\"Movie_ID\"], top_movies[\"Rating\"])\n",
        "plt.title(\"Top Rated Movies\")\n",
        "plt.xlabel(\"Movies_ID\")\n",
        "plt.ylabel(\"Rating\")\n",
        "plt.show()"
